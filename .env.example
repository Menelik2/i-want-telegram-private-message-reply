# ========================================================
# Telegram Private Message AI Auto-Reply Configuration
# ========================================================

# BOT MODE: 'userbot' (for your personal Telegram account) or 'bot' (for official BotFather bot)
BOT_MODE=userbot

# --------------------------------------------------------
# OPTION 1: USERBOT CREDENTIALS (Personal Account Auto-Reply)
# Get api_id & api_hash from: https://my.telegram.org -> API development tools
# --------------------------------------------------------
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890
TELETHON_SESSION_NAME=tg_ai_userbot

# --------------------------------------------------------
# OPTION 2: OFFICIAL BOT CREDENTIALS (BotFather Bot)
# Get token from Telegram @BotFather -> /newbot
# --------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# --------------------------------------------------------
# AI PROVIDER SELECTION: 'gemini' or 'openai'
# --------------------------------------------------------
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------
# BEHAVIOR & RULES
# --------------------------------------------------------
AUTO_REPLY_DELAY=2.0
REPLY_COOLDOWN_SECONDS=10
MAX_REPLIES_PER_HOUR=8
AWAY_MODE_ONLY=false

# --------------------------------------------------------
# FILTERS & ACCESS CONTROL (Comma-separated usernames without @, or user IDs)
# --------------------------------------------------------
WHITELIST_USERS=
BLACKLIST_USERS=spam_user,bot_spammer

# --------------------------------------------------------
# SYSTEM PROMPT / PERSONA
# --------------------------------------------------------
SYSTEM_PROMPT="You are a friendly, intelligent, and highly professional personal AI assistant. You are automatically replying to private 1-on-1 messages on behalf of the user because they are currently away or busy. Be polite, concise, and helpful. If they ask a general question, answer it clearly. If they ask for personal decisions or private info, let them know you have noted their message and the user will get back to them personally soon."
